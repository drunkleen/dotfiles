{
  "version": 1,
  "idle": {
    "screensaver": 150,
    "lock": 300
  },
  "bar": {
    "position": "top",
    "layout": {
      "left": [
        {
          "id": "miyamoto.menu"
        },
        {
          "id": "miyamoto.workspaces"
        }
      ],
      "center": [
        {
          "id": "omarchy.clock",
          "format": "dddd HH:mm",
          "formatAlt": "d MMMM 'W'ww yyyy",
          "verticalFormat": "HH\n\u2014\nmm"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "omarchy.monitor"
        },
        {
          "id": "omarchy.power"
        }
      ],
      "centerBegin": [
        {
          "id": "omarchy.indicators"
        }
      ],
      "centerEnd": [
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omarchy.system-update"
        }
      ]
    },
    "background": "opaque"
  },
  "plugins": [
    {
      "id": "miyamoto.lock"
    },
    {
      "id": "miyamoto.desktop-aio"
    }
  ],
  "disabledPlugins": [
    "omarchy.menu",
    "omarchy.lock"
  ],
  "cloneSourceRestores": [
    "miyamoto.menu",
    "miyamoto.lock"
  ]
}
