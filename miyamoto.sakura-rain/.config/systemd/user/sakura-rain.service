# Sakura Rain petal overlay. Started with the graphical session; control it
# with `sakura-rain start|stop|toggle|restart`.
# Not PartOf graphical-session.target: when the session target stops (compositor
# restart, lock/suspend transitions) that would kill the overlay with no restart.
# Restart=always brings it back whenever it exits, as long as it wasn't stopped by hand.
[Unit]
Description=Sakura Rain desktop petal overlay
After=graphical-session.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStart=%h/.local/bin/sakura-rain run
Restart=always
RestartSec=5

[Install]
WantedBy=graphical-session.target
