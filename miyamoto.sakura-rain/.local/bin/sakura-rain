#!/usr/bin/env python3
"""Control the Sakura Rain petal overlay.

Reads ~/.config/sakura-rain/config.toml and presets.toml, resolves them into
one settings object (defaults < preset < [settings]), validates it, and hands
it to the Quickshell config in ~/.config/quickshell/sakura-rain through the
SAKURA_RAIN_CONFIG environment variable.

Commands:
  run        resolve config and exec qs (what the systemd unit runs)
  start      start the user service
  stop       stop the user service
  restart    restart it (also how config edits take effect)
  toggle     start if stopped, stop if running
  status     show service state and the resolved settings
  config     validate and print the resolved settings as JSON
  logs       show recent service logs
"""
import argparse
import json
import os
import re
import subprocess
import sys
import tomllib
from pathlib import Path

XDG_CONFIG = Path(os.environ.get("XDG_CONFIG_HOME", Path.home() / ".config"))
CONFIG_DIR = Path(os.environ.get("SAKURA_RAIN_CONFIG_DIR", XDG_CONFIG / "sakura-rain"))
QML_DIR = XDG_CONFIG / "quickshell" / "sakura-rain"
UNIT = "sakura-rain.service"

# Fall speed in px/s at 1440 px of screen height; scaled per monitor.
FALL_SPEEDS = {"very_slow": 30.0, "slow": 60.0, "medium": 100.0, "fast": 160.0}
# Multiplier applied to spin and tumble rates.
ROTATION_SPEEDS = {"off": 0.0, "slow": 0.5, "medium": 1.0, "fast": 2.0}
LAYERS = ("background", "bottom", "top")
PRESET_NAMES = ("zen", "sakura", "storm", "custom")
HEX = re.compile(r"^#[0-9a-fA-F]{6}$")

DEFAULTS = {
    "petal_count": 25,
    "spawn_rate": 0.5,
    "fall_speed": "slow",
    "wind_strength": 0.15,
    "depth_spread": 0.6,
    "rotation_speed": "slow",
    "opacity": 0.75,
    "petal_size": [12, 28],
    "fps_limit": 30,
    "pause_on_fullscreen": True,
    "avoid_windows": True,
    "click_through": True,
    "color_palette": "dark_red",
    "rendering_layer": "background",
}
TOP_LEVEL_KEYS = {"enabled", "preset"}


class ConfigError(Exception):
    pass


def load_toml(path):
    if not path.exists():
        return {}
    with path.open("rb") as handle:
        try:
            return tomllib.load(handle)
        except tomllib.TOMLDecodeError as err:
            raise ConfigError(f"{path}: {err}") from err


def check_number(name, value, low, high):
    if isinstance(value, bool) or not isinstance(value, (int, float)):
        raise ConfigError(f"{name}: expected a number, got {value!r}")
    if not low <= value <= high:
        raise ConfigError(f"{name}: {value} is outside {low}..{high}")
    return float(value)


def check_int(name, value, low, high):
    if isinstance(value, bool) or not isinstance(value, int):
        raise ConfigError(f"{name}: expected an integer, got {value!r}")
    if not low <= value <= high:
        raise ConfigError(f"{name}: {value} is outside {low}..{high}")
    return value


def check_bool(name, value):
    if not isinstance(value, bool):
        raise ConfigError(f"{name}: expected true or false, got {value!r}")
    return value


def check_choice(name, value, choices):
    if value not in choices:
        allowed = ", ".join(map(str, choices)) or "none defined in presets.toml"
        raise ConfigError(f"{name}: {value!r} is not one of {allowed}")
    return value


def check_palette(name, raw):
    if not isinstance(raw, dict):
        raise ConfigError(f"palettes.{name}: must be a table")
    petals = raw.get("petals")
    if not isinstance(petals, list) or not petals:
        raise ConfigError(f"palettes.{name}: needs a non-empty petals list")
    for index, pair in enumerate(petals):
        for key in ("base", "tip"):
            if not isinstance(pair, dict) or not HEX.match(str(pair.get(key, ""))):
                raise ConfigError(f"palettes.{name}.petals[{index}].{key}: expected #RRGGBB")
    result = {"petals": [{"base": p["base"], "tip": p["tip"]} for p in petals]}
    accent = raw.get("accent")
    if accent is not None:
        for key in ("base", "tip"):
            if not HEX.match(str(accent.get(key, ""))):
                raise ConfigError(f"palettes.{name}.accent.{key}: expected #RRGGBB")
        result["accent"] = {"base": accent["base"], "tip": accent["tip"]}
        result["accent_chance"] = check_number(
            f"palettes.{name}.accent_chance", raw.get("accent_chance", 0.1), 0, 1)
    return result


def resolve():
    """Return (enabled, payload) where payload is what the QML side reads."""
    presets_doc = load_toml(CONFIG_DIR / "presets.toml")
    user = load_toml(CONFIG_DIR / "config.toml")

    unknown_top = set(user) - TOP_LEVEL_KEYS - {"settings"}
    if unknown_top:
        raise ConfigError(f"config.toml: unknown key(s) {', '.join(sorted(unknown_top))}")

    enabled = check_bool("enabled", user.get("enabled", True))
    preset = check_choice("preset", user.get("preset", "sakura"),
                          PRESET_NAMES)
    presets = presets_doc.get("presets", {})
    preset_values = presets.get(preset, {})
    user_settings = user.get("settings", {})
    if not isinstance(user_settings, dict):
        raise ConfigError("config.toml: [settings] must be a table")

    settings = {**DEFAULTS, **preset_values, **user_settings}
    unknown = set(settings) - set(DEFAULTS)
    if unknown:
        raise ConfigError(f"unknown setting(s): {', '.join(sorted(unknown))}")

    palettes = presets_doc.get("palettes", {})
    palette_name = check_choice("color_palette", settings["color_palette"], tuple(palettes))
    palette = check_palette(palette_name, palettes[palette_name])

    fall = settings["fall_speed"]
    if isinstance(fall, str):
        fall_px = FALL_SPEEDS[check_choice("fall_speed", fall, tuple(FALL_SPEEDS))]
    else:
        fall_px = check_number("fall_speed", fall, 0, 300)

    spin = settings["rotation_speed"]
    if isinstance(spin, str):
        spin = ROTATION_SPEEDS[check_choice("rotation_speed", spin, tuple(ROTATION_SPEEDS))]
    else:
        spin = check_number("rotation_speed", spin, 0, 4)

    size = settings["petal_size"]
    if not isinstance(size, list) or len(size) != 2:
        raise ConfigError("petal_size: expected [min, max] in px")
    size_min = check_number("petal_size[0]", size[0], 2, 120)
    size_max = check_number("petal_size[1]", size[1], 2, 120)
    if size_min > size_max:
        raise ConfigError("petal_size: min is larger than max")

    payload = {
        "petal_count": check_int("petal_count", settings["petal_count"], 1, 200),
        "spawn_rate": check_number("spawn_rate", settings["spawn_rate"], 0, 10),
        "fall_px": fall_px,
        "wind_strength": check_number("wind_strength", settings["wind_strength"], 0, 3),
        "depth_spread": check_number("depth_spread", settings["depth_spread"], 0, 1),
        "spin": spin,
        "opacity": check_number("opacity", settings["opacity"], 0, 1),
        "size_min": size_min,
        "size_max": size_max,
        "fps": check_int("fps_limit", settings["fps_limit"], 10, 120),
        "pause_on_fullscreen": check_bool("pause_on_fullscreen", settings["pause_on_fullscreen"]),
        "avoid_windows": check_bool("avoid_windows", settings["avoid_windows"]),
        "click_through": check_bool("click_through", settings["click_through"]),
        "layer": check_choice("rendering_layer", settings["rendering_layer"], LAYERS),
        "palette": palette,
    }
    return enabled, payload, preset


def print_error(message):
    print(f"sakura-rain: {message}", file=sys.stderr)


def systemctl(*args):
    return subprocess.run(["systemctl", "--user", *args]).returncode


def is_active():
    return subprocess.run(
        ["systemctl", "--user", "is-active", "--quiet", UNIT]).returncode == 0


def cmd_run(_args):
    if not os.environ.get("WAYLAND_DISPLAY"):
        print_error("WAYLAND_DISPLAY is not set; run this from a Wayland session")
        return 1
    if not QML_DIR.is_dir():
        print_error(f"missing {QML_DIR}; run scripts/sakura-rain-install")
        return 1
    enabled, payload, _preset = resolve()
    if not enabled:
        print("sakura-rain: disabled in config.toml (enabled = false)")
        return 0
    env = dict(os.environ, SAKURA_RAIN_CONFIG=json.dumps(payload))
    os.execvpe("qs", ["qs", "-p", str(QML_DIR)], env)


def cmd_start(_args):
    enabled, _payload, _preset = resolve()
    if not enabled:
        print_error("disabled in config.toml; set enabled = true to start")
        return 1
    return systemctl("start", UNIT)


def cmd_stop(_args):
    return systemctl("stop", UNIT)


def cmd_restart(_args):
    enabled, _payload, _preset = resolve()
    if not enabled:
        return systemctl("stop", UNIT)
    return systemctl("restart", UNIT)


def cmd_toggle(args):
    if is_active():
        return cmd_stop(args)
    return cmd_start(args)


def cmd_config(_args):
    _enabled, payload, preset = resolve()
    print(json.dumps({"preset": preset, **payload}, indent=2))
    return 0


def cmd_status(args):
    state = "active" if is_active() else "inactive"
    print(f"sakura-rain: {state}")
    try:
        cmd_config(args)
    except ConfigError as err:
        print_error(str(err))
        return 1
    return 0


def cmd_logs(_args):
    return subprocess.run(
        ["journalctl", "--user", "-u", UNIT, "-n", "80", "--no-pager"]).returncode


def build_parser():
    parser = argparse.ArgumentParser(prog="sakura-rain", description=__doc__,
                                     formatter_class=argparse.RawDescriptionHelpFormatter)
    sub = parser.add_subparsers(dest="command", required=True)
    commands = {
        "run": cmd_run, "start": cmd_start, "stop": cmd_stop, "restart": cmd_restart,
        "toggle": cmd_toggle, "status": cmd_status, "config": cmd_config, "logs": cmd_logs,
    }
    for name, handler in commands.items():
        sub.add_parser(name).set_defaults(func=handler)
    return parser


def main(argv=None):
    args = build_parser().parse_args(argv)
    try:
        return args.func(args)
    except ConfigError as err:
        print_error(str(err))
        return 2


if __name__ == "__main__":
    sys.exit(main())
