[Unit]
Description=Omarchy desktop AIO widget (Ryoku-style)
Documentation=https://github.com/Ryoku-dev/ryoku
PartOf=graphical-session.target
After=graphical-session.target graphical-session-pre.target
ConditionEnvironment=WAYLAND_DISPLAY

[Service]
Type=simple
ExecStart=/usr/bin/quickshell -p %h/.config/omarchy-desktop-widget/shell.qml
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
