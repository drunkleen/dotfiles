{
  "bar": {
    "centerAnchor": "omarchy.clock",
    "layout": {
      "center": [
        {
          "id": "omarchy.indicators"
        },
        {
          "id": "omarchy.clock"
        },
        {
          "id": "omarchy.keyboard-layout"
        },
        {
          "id": "omarchy.weather"
        },
        {
          "id": "omamail",
          "refreshIntervalSec": 120,
          "maxMessages": 50,
          "heavyMessageRendering": "Show plain text first",
          "contentDirection": "Auto",
          "appearance": "System",
          "defaultQuery": "in:inbox",
          "notifyNewMail": "On",
          "oauthPort": 9481,
          "undoSendSeconds": 10,
          "unifiedCalendarView": true,
          "showBarIcon": true,
          "unifiedMailboxes": false,
          "suggestEvents": false
        },
        {
          "id": "stappmus.activity-monitor"
        },
        {
          "id": "quickshell.spotify",
          "deviceName": "Holy Arch",
          "idleShutdownMinutes": 15,
          "showMiniPlayer": "On",
          "shortcutPlayer": "Omarchy Music app",
          "shortcutHints": "Off",
          "showTrackTitle": "On",
          "showArtistName": "Off",
          "showPausedTrack": "On",
          "scrollBarText": "Off",
          "scrollSpeed": "1",
          "maxBarTextWidth": "240",
          "audioQuality": "320 kbps"
        },
        {
          "id": "omarchy.system-update"
        }
      ],
      "left": [
        {
          "id": "omarchy.menu"
        },
        {
          "id": "omarchy.workspaces"
        },
        {
          "id": "omarchy.active-window"
        }
      ],
      "right": [
        {
          "id": "omarchy.tray"
        },
        {
          "id": "io.github.x3me.nexthop",
          "meteredCare": false
        },
        {
          "id": "io.github.thisisgm.omapods"
        },
        {
          "id": "omarchy.lock",
          "lockOnUnplug": false,
          "notifyOnKeyChange": true
        },
        {
          "id": "omarchy.tailscale"
        },
        {
          "id": "omarchy.agents"
        },
        {
          "id": "omarchy.bluetooth"
        },
        {
          "id": "omarchy.network"
        },
        {
          "id": "omarchy.audio"
        },
        {
          "id": "im0001gt.screens"
        },
        {
          "id": "omarchy.power"
        },
        {
          "id": "omarchy.osd"
        },
        {
          "id": "omarchy.dev-gallery"
        }
      ]
    },
    "position": "top",
    "transparent": true
  },
  "idle": {
    "lock": 300,
    "screensaver": 150
  },
  "plugins": [
    {
      "id": "drunkleen.pixlock"
    },
    {
      "id": "drunkleen.paperwidget"
    },
    {
      "id": "bobbynicholas.omaland"
    }
  ],
  "version": 1,
  "disabledPlugins": [
    "omarchy.lock"
  ],
  "cloneSourceRestores": [
    "drunkleen.pixlock"
  ]
}
