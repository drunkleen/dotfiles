#!/usr/bin/env bash
# Replace only the stock menu button and workspace labels; keep the stock bar.
set -euo pipefail
live_shell="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/shell.json"
defaults="${OMARCHY_PATH:-/usr/share/omarchy}/config/omarchy/shell.json"
case "${1:-}" in
  apply|diff) ;;
  *) echo 'Usage: miyamoto-bar <apply|diff> (full-shell capture is no longer supported)' >&2; exit 1 ;;
esac
for id in miyamoto.menu miyamoto.workspaces; do
  [[ -f ${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/plugins/$id/manifest.json ]] || {
    echo "miyamoto-bar: missing $id; install plugins with setup-omarchy-customizations first" >&2
    exit 1
  }
done
mkdir -p -- "$(dirname -- "$live_shell")"
tmp=$(mktemp "${live_shell}.tmp.XXXXXX")
trap 'rm -f -- "$tmp"' EXIT
source_file="$live_shell"
[[ -f $source_file ]] || source_file="$defaults"
jq --slurpfile defaults "$defaults" '
  # Omarchy uses a complete user config, so derive the whole bar from its
  # installed defaults at apply time, changing only these two widget IDs.
  .bar = $defaults[0].bar |
  .bar.layout |= (
    with_entries(.value |= map(
      if .id == "omarchy.menu" then .id = "miyamoto.menu"
      elif .id == "omarchy.workspaces" then .id = "miyamoto.workspaces"
      else . end))) |
  if has("disabledPlugins") then
    .disabledPlugins |= map(select(. != "omarchy.menu" and . != "miyamoto.menu" and . != "miyamoto.workspaces"))
  else . end |
  if has("cloneSourceRestores") then
    .cloneSourceRestores |= map(select(. != "miyamoto.menu"))
  else . end
' "$source_file" > "$tmp"
if [[ $1 == diff ]]; then
  diff -u "$source_file" "$tmp" || [[ $? == 1 ]]
  exit
fi
if cmp -s "$source_file" "$tmp"; then
  echo 'miyamoto-bar: menu and Japanese workspace labels already applied'
  exit
fi
if [[ -f $live_shell ]]; then
  backup="${live_shell}.backup.$(date +%Y%m%d-%H%M%S).$$"
  cp -p -- "$live_shell" "$backup"
  echo "miyamoto-bar: backup -> $backup"
fi
chmod 644 "$tmp"
mv -f -- "$tmp" "$live_shell"
# shell.json and plugin files hot-reload; no full-shell restart required.
echo 'miyamoto-bar: applied 宮本 menu button and Japanese workspace labels'
