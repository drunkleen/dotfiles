#!/usr/bin/env bash
#
# Sync the omarchy-bar stow package's shell.json (copy-managed).
#
# Plugins under omarchy-bar/.config/omarchy/plugins/ are stow-managed.
# shell.json is NOT stowed: Omarchy rewrites it with atomic writes
# (temp file + rename), which would replace a stow symlink with a real file
# and silently un-manage it. So it is copied both ways here.
#
# Usage:
#   omarchy-bar apply     copy repo -> live, then restart the shell
#   omarchy-bar capture   copy live -> repo (then commit the repo)
#   omarchy-bar diff      show live vs repo differences
set -euo pipefail

repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
pkg_shell="$repo_dir/omarchy-bar/.config/omarchy/shell.json"
live_shell="${XDG_CONFIG_HOME:-$HOME/.config}/omarchy/shell.json"

case "${1:-}" in
  apply)
    [[ -f $pkg_shell ]] || { echo "omarchy-bar: missing $pkg_shell" >&2; exit 1; }
    install -Dm644 "$pkg_shell" "$live_shell"
    echo "omarchy-bar: applied shell.json -> $live_shell"
    if command -v omarchy >/dev/null 2>&1; then
      omarchy restart shell >/dev/null 2>&1 && echo "omarchy-bar: restarted Omarchy shell" || true
    fi
    ;;
  capture)
    [[ -f $live_shell ]] || { echo "omarchy-bar: missing $live_shell" >&2; exit 1; }
    install -Dm644 "$live_shell" "$pkg_shell"
    echo "omarchy-bar: captured $live_shell -> $pkg_shell (commit to save)"
    ;;
  diff)
    diff -u "$pkg_shell" "$live_shell" || true
    ;;
  *)
    echo "Usage: omarchy-bar <apply|capture|diff>" >&2
    exit 1
    ;;
esac
