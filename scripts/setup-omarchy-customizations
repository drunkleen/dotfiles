#!/usr/bin/env bash

set -euo pipefail

repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

dry_run=false
case "${1:-}" in
  --dry-run) dry_run=true ;;
  --help|-h)
    echo 'Usage: scripts/setup-omarchy-customizations [--dry-run]'
    echo 'Back up conflicts, stow all packages, then apply theme, bar, Limine, Plymouth and lock.'
    exit 0 ;;
  "") ;;
  *) echo "Unknown option: $1" >&2; exit 2 ;;
esac
(( $# <= 1 )) || { echo 'Too many arguments' >&2; exit 2; }
(( EUID != 0 )) || { echo 'Run as your normal desktop user; sudo is requested for boot themes only.' >&2; exit 1; }

packages=()
for directory in "$repo_dir"/*/; do
  case "$(basename "$directory")" in leenium.omarchy|miyamoto.sakura-rain) continue ;; esac
  if [[ -e $directory/.config || -e $directory/.local || -e $directory/.icons ||
        -e $directory/.zshrc || -e $directory/.gitconfig ]]; then
    packages+=("$(basename "$directory")")
  fi
done
((${#packages[@]})) || { echo 'No Stow packages found' >&2; exit 1; }

run() {
  if $dry_run; then printf '[dry-run] '; printf '%q ' "$@"; printf '\n'; else "$@"; fi
}

if $dry_run; then
  "$repo_dir/scripts/stow-with-backups" --dry-run "${packages[@]}"
else
  for tool in stow python3 git sudo omarchy jq fc-cache gsettings limine limine-update plymouth-set-default-theme; do
    command -v "$tool" >/dev/null || { echo "Missing prerequisite: $tool" >&2; exit 1; }
  done
  pacman -Q capitaine-cursors >/dev/null || { echo 'Install capitaine-cursors first.' >&2; exit 1; }
  [[ -f $repo_dir/miyamoto.lock/.config/omarchy/plugins/miyamoto.lock/theme/font/Outfit-Black.ttf ]] || {
    echo 'Lock/Plymouth font missing; initialize repository submodules first.' >&2; exit 1;
  }
  sudo -v
  "$repo_dir/scripts/stow-with-backups" "${packages[@]}"
fi

run "$repo_dir/scripts/setup-btop-theme"
run "$repo_dir/scripts/install-leenium-theme"
run "$repo_dir/scripts/miyamoto-bar" apply

# Keep the clone private to this invocation; remove it on success or failure.
if $dry_run; then
  echo '[dry-run] Clone https://github.com/drunkleen/leenium.limine.git into a private temporary directory'
  echo '[dry-run] Back up existing Limine/Plymouth configs and theme, then sudo ./install.sh from that clone'
  echo '[dry-run] sudo miyamoto.plymouth/install.sh (selects Plymouth and rebuilds initramfs)'
else
  temporary=$(mktemp -d -t leenium-setup.XXXXXXXX)
  trap 'rm -rf -- "$temporary"' EXIT
  git clone -- https://github.com/drunkleen/leenium.limine.git "$temporary/leenium.limine"
  stamp=$(date +%Y%m%d-%H%M%S).$$
  for file in /boot/limine.conf /etc/default/limine /etc/plymouth/plymouthd.conf /usr/share/plymouth/themes/miyamoto; do
    if sudo test -e "$file"; then
      sudo cp -a -- "$file" "$file-backup-$stamp"
      echo "Boot config backup: $file-backup-$stamp"
    fi
  done
  (cd "$temporary/leenium.limine" && sudo ./install.sh)
  sudo bash "$repo_dir/miyamoto.plymouth/install.sh"
fi
run omarchy plugin enable miyamoto.lock
run "$repo_dir/scripts/install-desktop-aio"

if $dry_run; then
  echo '[dry-run] Finish font cache, cursor, resume service, terminal and login-shell preferences'
  exit 0
fi

# Runtime deps for the desktop widget (spectrum + fonts). Non-fatal: warn only.
missing=()
for pkg in cava inter-font ttf-material-symbols-variable curl libpulse; do
  pacman -Q "$pkg" >/dev/null 2>&1 || missing+=("$pkg")
done
if ((${#missing[@]})); then
  printf '%s\n' "Desktop widget: install missing packages with: sudo pacman -S ${missing[*]}" >&2
fi

fc-cache -f "$HOME/.local/share/fonts"

systemctl --user daemon-reload
systemctl --user enable --now omarchy-fcitx5-resume.service

gsettings set org.gnome.desktop.interface cursor-theme 'capitaine-cursors'
gsettings set org.gnome.desktop.interface cursor-size 24

if command -v hyprctl >/dev/null 2>&1; then
  hyprctl setcursor capitaine-cursors 24
fi

"$repo_dir/scripts/setup-default-terminal"
"$repo_dir/scripts/setup-default-shell"

printf '%s\n' 'Omarchy bar, lock, desktop widget, theme, font, Hyprland config, resume input fix, Ghostty default terminal, and Zsh login shell installed.'
