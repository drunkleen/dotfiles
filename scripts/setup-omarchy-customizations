#!/usr/bin/env bash

set -euo pipefail

repo_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"

if ! pacman -Q capitaine-cursors >/dev/null 2>&1; then
  printf '%s\n' 'Missing package: install it with sudo pacman -S capitaine-cursors' >&2
  exit 1
fi

cd "$repo_dir"
stow hypr omarchy miyamoto.bar miyamoto.lock miyamoto.desktop-aio leenium.omarchy

# Runtime deps for the desktop widget (spectrum + fonts). Non-fatal: warn only.
missing=()
for pkg in cava inter-font ttf-material-symbols-variable; do
  pacman -Q "$pkg" >/dev/null 2>&1 || missing+=("$pkg")
done
if ((${#missing[@]})); then
  printf '%s\n' "Desktop widget: install missing packages with: sudo pacman -S ${missing[*]}" >&2
fi

fc-cache -f "$HOME/.local/share/fonts"

systemctl --user daemon-reload
systemctl --user enable --now omarchy-fcitx5-resume.service

gsettings set org.gnome.desktop.interface cursor-theme 'capitaine-cursors'
gsettings set org.gnome.desktop.interface cursor-size 24

if command -v hyprctl >/dev/null 2>&1; then
  hyprctl setcursor capitaine-cursors 24
fi

if command -v omarchy-shell >/dev/null 2>&1; then
  # Deploys shell.json (bar layout + plugin enablement) and restarts the shell,
  # which also rescans the plugin registry.
  "$repo_dir/scripts/miyamoto-bar" apply
else
  printf '%s\n' 'Omarchy shell not found; run scripts/miyamoto-bar apply after installing Omarchy.'
fi

printf '%s\n' 'Omarchy bar, lock, desktop widget, theme, font, Hyprland config, and resume input fix installed.'
